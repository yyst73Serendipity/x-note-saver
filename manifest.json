{
  "manifest_version": 3,
  "name": "Twitter 笔记收藏",
  "version": "2.0.0",
  "description": "浏览 Twitter/x.com 时收藏和分类推文",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.x.com/*",
    "https://*.googleapis.com/*",
    "https://*.web.app/*"
  ],
  "background": {
    "service_worker": "build/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Twitter 笔记收藏",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "minimum_chrome_version": "116",
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://*.web.app https://*.firebaseapp.com; connect-src 'self' https://*.googleapis.com https://*.firebaseapp.com https://*.web.app;"
  }
}
