{
  "manifest_version": 3,
  "name": "Twitter 笔记收藏",
  "version": "1.0.0",
  "description": "浏览 Twitter/x.com 时收藏和分类推文",

  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "*://*.x.com/*"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.x.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Twitter 笔记收藏",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  }
}
